
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=64
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_LWIP_UDP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# WiFi TX 静态缓冲 16->8，每个约 1.6KB，省出约 12.8KB 内部 DMA 内存
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8

# 指令 cache 32KB -> 16KB：本次唯一真实有效的一刀，DIRAM 主堆区 +16KB。
#   IDF 帮助原文：16KB 档位下“另外 16KB 由堆分配器管理”。
#   机制：memory.ld 中 iram0_0_seg 的 org = 0x40370000 + icache_size
#     -> _iram_start 0x40378000 -> 0x40374000，IRAM 代码前 16KB 移出 DRAM 共享窗
#     -> _data_start 0x3FCA2000 -> 0x3FC9D000，_heap_start 0x3FCAFE90 -> 0x3FCABE90
#     -> 主堆区 230KiB -> 246KiB（内部堆合计 290 -> 306KiB）
#   代价：Flash/PSRAM 指令缓存命中率略降，语音场景无感。
CONFIG_ESP32S3_INSTRUCTION_CACHE_16KB=y

# 数据 cache 16KB：编译期未观测到收益（dram0_0_seg 长度 0x53700 未变），保留待运行期确认。
#   Kconfig 原文：16KB 档位下硬件仍是 32KB cache，另 16KB 在启动时让给堆，
#   因此下面的 CONFIG_ESP32S3_DATA_CACHE_SIZE=0x8000 不是配置错误。
#   heap/port/esp32s3/memory_layout.c:100 会注册 {0x3C000000, 16KB} 为 DRAM 区，
#   但它与开启 SPIRAM 时的外部内存窗 0x3C000000~0x3E000000 同基址重叠，
#   是否真的进堆要看开机日志有没有多出 “At 3C000000 len 00004000 (16 KiB): DRAM”。
CONFIG_ESP32S3_DATA_CACHE_16KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y

# FATFS 长文件名支持（用于访问 /sdcard/white-noise 这类目录）
# CONFIG_FATFS_LFN_NONE is not set
CONFIG_FATFS_LFN_HEAP=y
# CONFIG_FATFS_LFN_STACK is not set
